PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost/oidc_implementation
REDIS_URL=redis://localhost:6379
ISSUER_URL=http://localhost:8000
SESSION_SECRET=replace-with-a-strong-secret
OIDC_COOKIE_KEYS=dev-key-1,dev-key-2
OIDC_PRIVATE_KEY_PATH=./keys/private.pem
OIDC_PUBLIC_KEY_PATH=./keys/public.pem
OIDC_JWKS_PATH=./keys/jwks.json
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/external/google/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/external/github/callback
FRONTEND_URL=http://localhost:3000
OIDC_CLIENTS_JSON=[{"client_id":"test-web-app","client_secret":"test-secret-change-me","redirect_uris":["http://localhost:4000/callback"],"grant_types":["authorization_code","refresh_token"],"response_types":["code"]}]